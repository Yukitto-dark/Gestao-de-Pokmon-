<Window x:Class="GestaoDePokemon.Windowmenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestaoDePokemon"
        mc:Ignorable="d"
        Title="Windowmenu" Height="450" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="/images/floor.png" Stretch="UniformToFill"></ImageBrush>
    </Window.Background>
    <Grid>
        <Button HorizontalAlignment="Left" Margin="25,164,0,0" VerticalAlignment="Top" Height="74" Width="114">
            <StackPanel>
                <Image Source="/images/map.png" Height="71" Width="113" RenderTransformOrigin="0.509,0.5" />
            </StackPanel>
        </Button>
        <Button HorizontalAlignment="Center" Margin="0,361,0,0" VerticalAlignment="Top" Height="73" Width="119">
            <StackPanel>
                <Image Source="/images/exit.png" Height="71" Width="139" />
            </StackPanel>
        </Button>
        <Button HorizontalAlignment="Left" Margin="708,158,0,0" VerticalAlignment="Top" Height="80" Width="74">
            <StackPanel>
                <Image Source="/images/table.png" Height="71" Width="139" />
            </StackPanel>
        </Button>
        <Image HorizontalAlignment="Center" Height="188" Margin="0,158,0,0" VerticalAlignment="Top" Width="208" Source="/images/ethan.png"/>
        <Rectangle HorizontalAlignment="Center" Height="88" Stroke="Black" VerticalAlignment="Top" Width="800">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/images/wall.png" />
            </Rectangle.Fill>
        </Rectangle>
        <Button HorizontalAlignment="Left" Margin="370,39,0,0" VerticalAlignment="Top" Height="92" Width="60">
            <StackPanel>
                <Image Source="/images/PC.png" Height="89" Width="63" />
            </StackPanel>
        </Button>
        <Image HorizontalAlignment="Left" Height="78" Margin="175,346,0,0" VerticalAlignment="Top" Width="43" Source="/images/deco1.png"/>
        <Image HorizontalAlignment="Left" Height="100" Margin="554,38,0,0" VerticalAlignment="Top" Width="100" Source="/images/deco2.png"/>
        <Image HorizontalAlignment="Left" Height="78" Margin="583,346,0,0" VerticalAlignment="Top" Width="43" Source="/images/deco1.png"/>
        <Image HorizontalAlignment="Left" Height="100" Margin="146,38,0,0" VerticalAlignment="Top" Width="100" Source="/images/deco2.png"/>
        <Image HorizontalAlignment="Left" Height="46" Margin="640,158,0,0" VerticalAlignment="Top" Width="41" Source="/images/deco3.png"/>
        <Image HorizontalAlignment="Left" Height="46" Margin="640,207,0,0" VerticalAlignment="Top" Width="41" Source="/images/deco4.png"/>
        <Image HorizontalAlignment="Left" Height="46" Margin="25,259,0,0" VerticalAlignment="Top" Width="41" Source="/images/deco4.png"/>
        <Image HorizontalAlignment="Left" Height="46" Margin="84,259,0,0" VerticalAlignment="Top" Width="41" Source="/images/deco3.png"/>

    </Grid>
</Window>
