    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Controller\" />
    <Folder Include="Data\" />
    <Folder Include="View\images\" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="View\Telas - background\*.png" />
    <Resource Include="View\Telas - background\*.png" />
    <None Remove="View\images\Tipagem\*.png" />
    <Resource Include="View\images\Tipagem\*.png" />
    <None Remove="View\images\hert-full.png" />
    <Resource Include="View\images\hert-full.png" />
    <None Remove="View\images\hert-full-vazio.png" />
    <Resource Include="View\images\hert-full-vazio.png" />
    <None Remove="View\fonts\*.ttf" />
    <Resource Include="View\fonts\*.ttf" />
    <None Remove="View\cursors\*.cur" />
