            </Label>
            <Label Content="Galar" HorizontalAlignment="Left" Height="28" Margin="595,357,0,0" VerticalAlignment="Top" Width="90" FontFamily="/View/fonts/#Pokemon Fire Red" FontSize="18" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" IsHitTestVisible="False">
                <Label.Effect>
                    <DropShadowEffect Color="Black" ShadowDepth="2" Direction="315" BlurRadius="0" Opacity="1"/>
                </Label.Effect>
            </Label>
            <Label Content="Paldea" HorizontalAlignment="Left" Height="28" Margin="710,184,0,0" VerticalAlignment="Top" Width="90" FontFamily="/View/fonts/#Pokemon Fire Red" FontSize="18" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" IsHitTestVisible="False">
