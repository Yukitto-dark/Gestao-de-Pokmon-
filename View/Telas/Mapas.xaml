                </Label.Effect>
            </Label>
            <Label Content="Hoenn" HorizontalAlignment="Left" Height="43" Margin="591,1,0,0" VerticalAlignment="Top" Width="93" FontFamily="/View/fonts/#Pokemon Fire Red" FontSize="24" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Label.Effect>
                    <DropShadowEffect Color="Black" ShadowDepth="2" Direction="315" BlurRadius="0" Opacity="1"/>
                </Label.Effect>
            </Label>

            <!-- Demais regiões: mesas da sala e o mapa na parede (Hisui). -->
            <Button x:Name="Ir__Sinnoh" Tag="Sinnoh" Click="Regiao_Click" Content="Button" HorizontalAlignment="Left" Height="56" Margin="112,185,0,0" VerticalAlignment="Top" Width="96" Opacity="0" ToolTip="Sinnoh"/>
            <Button x:Name="Ir__Unova" Tag="Unova" Click="Regiao_Click" Content="Button" HorizontalAlignment="Left" Height="56" Margin="352,235,0,0" VerticalAlignment="Top" Width="96" Opacity="0" ToolTip="Unova"/>
