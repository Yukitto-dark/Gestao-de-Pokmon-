<Page x:Class="GestaoDePokemon.View.Telas.Mapas"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GestaoDePokemon.View.Telas"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Mapas"
      Background="Black">

    <Viewbox Stretch="Uniform">
        <Grid Width="800" Height="450">
            <Image Source="/View/Telas - background/Mapas.png" Stretch="Uniform"/>
            <Button x:Name="Voltar__Home" Click="Navegar_Click" Content="Button" HorizontalAlignment="Left" Height="46" Margin="338,400,0,0" VerticalAlignment="Top" Width="126" Opacity="0"/>
            <Button x:Name="Ir__Kanto" Tag="Kanto" Click="Regiao_Click" Content="Button" HorizontalAlignment="Left" Height="61" Margin="114,48,0,0" VerticalAlignment="Top" Width="93" Opacity="0"/>
            <Button x:Name="Ir__Johto" Tag="Johto" Click="Regiao_Click" Content="Button" HorizontalAlignment="Left" Height="61" Margin="355,48,0,0" VerticalAlignment="Top" Width="93" Opacity="0"/>
            <Button x:Name="Ir__Hoenn" Tag="Hoenn" Click="Regiao_Click" Content="Button" HorizontalAlignment="Left" Height="61" Margin="591,48,0,0" VerticalAlignment="Top" Width="93" Opacity="0"/>
            <Label Content="Kanto" HorizontalAlignment="Left" Height="43" Margin="114,1,0,0" VerticalAlignment="Top" Width="93" FontFamily="/View/fonts/#Pokemon Fire Red" FontSize="24" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Label.Effect>
                    <DropShadowEffect Color="Black" ShadowDepth="2" Direction="315" BlurRadius="0" Opacity="1"/>
                </Label.Effect>
            </Label>
            <Label Content="Johto" HorizontalAlignment="Left" Height="43" Margin="355,1,0,0" Width="93" FontFamily="/View/fonts/#Pokemon Fire Red" FontSize="24" Foreground="White" HorizontalContentAlignment="Center" VerticalAlignment="Top" VerticalContentAlignment="Center">
                <Label.Effect>
                    <DropShadowEffect Color="Black" ShadowDepth="2" Direction="315" BlurRadius="0" Opacity="1"/>
                </Label.Effect>
            </Label>
            <Label Content="Hoenn" HorizontalAlignment="Left" Height="43" Margin="591,1,0,0" VerticalAlignment="Top" Width="93" FontFamily="/View/fonts/#Pokemon Fire Red" FontSize="24" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Label.Effect>
                    <DropShadowEffect Color="Black" ShadowDepth="2" Direction="315" BlurRadius="0" Opacity="1"/>
                </Label.Effect>
            </Label>

        </Grid>
    </Viewbox>
</Page>
