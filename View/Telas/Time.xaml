            <Image x:Name="Party_4" Tag="4" HorizontalAlignment="Left" Height="55.77" Margin="528.325,193.615,0,0" VerticalAlignment="Top" Width="64.35" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="Party_Click"/>
            <Image x:Name="Party_5" Tag="5" HorizontalAlignment="Left" Height="55.77" Margin="248.325,313.615,0,0" VerticalAlignment="Top" Width="64.35" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="Party_Click"/>
            <Image x:Name="Party_6" Tag="6" HorizontalAlignment="Left" Height="55.77" Margin="488.325,313.615,0,0" VerticalAlignment="Top" Width="64.35" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="Party_Click"/>
