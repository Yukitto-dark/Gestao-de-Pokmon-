<Page x:Class="GestaoDePokemon.View.Telas.Regioes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GestaoDePokemon.View.Telas"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Regiões"
      Background="Black">

    <Page.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FF51608A" CornerRadius="5" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabRegiao" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFAEBEE8"/>
            <Setter Property="FontFamily" Value="/View/fonts/#Pokemon Fire Red"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#FF2A3350" BorderBrush="#FF1E2740" BorderThickness="2" CornerRadius="4">
                            <Border x:Name="inner" Background="Transparent" BorderBrush="#FF51608A" BorderThickness="1" Margin="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect Color="Black" ShadowDepth="2" Direction="315" BlurRadius="0" Opacity="1"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3A4468"/>
                                <Setter TargetName="inner" Property="BorderBrush" Value="#FFAEBEE8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF51608A"/>
                                <Setter TargetName="inner" Property="BorderBrush" Value="#FFD6E0FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoRota" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="/View/fonts/#Pokemon Fire Red"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FF2A3350" BorderBrush="#FF1E2740" BorderThickness="2" CornerRadius="4">
                            <Border x:Name="inner" Background="Transparent" BorderBrush="#FF51608A" BorderThickness="1" Margin="1">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="8,0"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3A4468"/>
                                <Setter TargetName="inner" Property="BorderBrush" Value="#FFAEBEE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF51608A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="800" Height="450">
            <Image Source="/View/Telas - background/Mapas.png" Stretch="Uniform"/>
            <Border Background="#B3000000"/>

            <Border Margin="36" Background="#FF1B2236" BorderBrush="#FF51608A" BorderThickness="3" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="Black" ShadowDepth="6" Direction="315" BlurRadius="0" Opacity="0.9"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FF141A2B" BorderBrush="#FF51608A" BorderThickness="0,0,0,2" CornerRadius="7,7,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                <RadioButton x:Name="Tab_Kanto" Content="Kanto" Tag="Kanto" Style="{StaticResource TabRegiao}"
                                             Width="150" Height="38" Margin="8,0" GroupName="Regiao" Checked="Regiao_Checked"/>
                                <RadioButton x:Name="Tab_Johto" Content="Johto" Tag="Johto" Style="{StaticResource TabRegiao}"
                                             Width="150" Height="38" Margin="8,0" GroupName="Regiao" Checked="Regiao_Checked"/>
                                <RadioButton x:Name="Tab_Hoenn" Content="Hoenn" Tag="Hoenn" Style="{StaticResource TabRegiao}"
                                             Width="150" Height="38" Margin="8,0" GroupName="Regiao" Checked="Regiao_Checked"/>
                            </StackPanel>
                            <Button x:Name="Voltar__Mapas" Content="Voltar" Style="{StaticResource BotaoRota}"
                                    Width="100" Height="32" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center" Click="Navegar_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FF141A2B" BorderBrush="#FF51608A" BorderThickness="2" CornerRadius="6" Padding="8">
                            <ScrollViewer x:Name="Rotas_Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="Lista_Rotas"/>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="2" Background="#FF141A2B" BorderBrush="#FF51608A" BorderThickness="2" CornerRadius="6">
                            <ScrollViewer x:Name="Info_Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Padding="22,18,16,22">
                                <StackPanel>
                                    <TextBlock x:Name="Titulo_Rota" Text="Informações da rota" FontFamily="/View/fonts/#Pokemon Fire Red"
                                               FontSize="26" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,20">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="Black" ShadowDepth="2" Direction="315" BlurRadius="0" Opacity="1"/>
                                        </TextBlock.Effect>
                                    </TextBlock>

                                    <TextBlock Text="Pokémons que aparecem" FontFamily="/View/fonts/#Pokemon Fire Red" FontSize="17"
                                               Foreground="#FFAEBEE8" Margin="0,0,0,10"/>
                                    <WrapPanel x:Name="Pokemons_Rota" Margin="0,0,0,20"/>

                                    <TextBlock Text="Informações gerais" FontFamily="/View/fonts/#Pokemon Fire Red" FontSize="17"
                                               Foreground="#FFAEBEE8" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="Informacoes_Rota" TextWrapping="Wrap" FontSize="15" LineHeight="24"
                                               Foreground="#FFD6E0FF" Margin="0,0,0,24"/>

                                    <TextBlock Text="Mapa" FontFamily="/View/fonts/#Pokemon Fire Red" FontSize="17"
                                               Foreground="#FFAEBEE8" Margin="0,0,0,10"/>
                                    <Image x:Name="Mapa_Rota" Stretch="Uniform" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</Page>
