<Page x:Class="GestaoDePokemon.View.Telas.Box"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GestaoDePokemon.View.Telas"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Box">

    <Page.Resources>
        <Style x:Key="HotspotTipo" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#66000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotaoPokemon" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="/View/fonts/#Pokemon Fire Red"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FF51608A" BorderBrush="#FF1E2740" BorderThickness="2" CornerRadius="0">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="2" Direction="315" BlurRadius="0" Opacity="0.8"/>
                            </Border.Effect>
                            <Border x:Name="inner" Background="Transparent" BorderBrush="#FFAEBEE8" BorderThickness="1" Margin="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect Color="Black" ShadowDepth="2" Direction="315" BlurRadius="0" Opacity="1"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF63739F"/>
                                <Setter TargetName="inner" Property="BorderBrush" Value="#FFD6E0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3A4468"/>
                                <Setter TargetName="inner" Property="BorderBrush" Value="#FF8DA0D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Interruptor" TargetType="ToggleButton">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="trilho" Background="#FF3A4468" BorderBrush="#FF1E2740" BorderThickness="2"/>
                            <Border x:Name="botao" Width="18" Height="18" Background="#FFAEBEE8" BorderBrush="#FF1E2740" BorderThickness="1" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center">
                                <ContentPresenter Margin="1"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="trilho" Property="Background" Value="#FF51608A"/>
                                <Setter TargetName="botao" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="botao" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoCoracao" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Viewbox Stretch="Fill">
        <Grid Width="800" Height="450" PreviewMouseLeftButtonUp="Grade_Click">
            <Image Margin="0,0,0,10" Source="/View/Telas - background/Box - reforge --.png" Stretch="Fill"/>
            <Button Content="Button" HorizontalAlignment="Left" Height="10" Margin="455,0,0,0" VerticalAlignment="Top" Width="1" Opacity="0"/>
            <Button x:Name="Voltar__Home" Click="Navegar_Click" Content="Button" HorizontalAlignment="Left" Height="43" Margin="455,0,0,0" VerticalAlignment="Top" Width="198" Opacity="0"/>
            <Button x:Name="Ir_favoritos" Click="Navegar_Click" Content="Button" HorizontalAlignment="Left" Height="43" Margin="227,5,0,0" VerticalAlignment="Top" Width="198" Opacity="0"/>
            <TextBox x:Name="Informação_Pokemon" HorizontalAlignment="Left" Margin="10,246,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="197" Height="148" Background="Transparent"/>
            <Image x:Name="Imagem_Pokemon" HorizontalAlignment="Left" Height="131" Margin="43,73,0,0" VerticalAlignment="Top" Width="143"/>
            <Button x:Name="Ant_Box" Content="Button" HorizontalAlignment="Left" Height="34" Margin="233,68,0,0" VerticalAlignment="Top" Width="23" Opacity="0" Click="Ant_Box_Click"/>
            <Button x:Name="Prox_Box" Content="Button" HorizontalAlignment="Left" Height="34" Margin="615,68,0,0" VerticalAlignment="Top" Width="23" Opacity="0" Click="Prox_Box_Click"/>
            <Label x:Name="Numeração_Box" Content="1 - 70" HorizontalAlignment="Left" Height="40" Margin="336,64,0,0" VerticalAlignment="Top" Width="200" FontFamily="/View/fonts/#Pokemon Fire Red" FontSize="40" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Label.Effect>
                    <DropShadowEffect Color="Black" ShadowDepth="4" Direction="315" BlurRadius="0" Opacity="1"/>
                </Label.Effect>
            </Label>
            <Image x:Name="_1" HorizontalAlignment="Left" Height="60" Margin="247,121,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_2" HorizontalAlignment="Left" Height="60" Margin="310,121,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_3" HorizontalAlignment="Left" Height="60" Margin="373,121,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_4" HorizontalAlignment="Left" Height="60" Margin="436,121,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_5" HorizontalAlignment="Left" Height="60" Margin="499,121,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_6" HorizontalAlignment="Left" Height="60" Margin="562,121,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_7" HorizontalAlignment="Left" Height="60" Margin="247,180,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_8" HorizontalAlignment="Left" Height="60" Margin="310,180,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_9" HorizontalAlignment="Left" Height="60" Margin="373,180,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_10" HorizontalAlignment="Left" Height="60" Margin="436,180,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_11" HorizontalAlignment="Left" Height="60" Margin="499,180,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_12" HorizontalAlignment="Left" Height="60" Margin="562,180,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_13" HorizontalAlignment="Left" Height="60" Margin="247,239,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_14" HorizontalAlignment="Left" Height="60" Margin="310,239,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_15" HorizontalAlignment="Left" Height="60" Margin="373,239,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_16" HorizontalAlignment="Left" Height="60" Margin="436,239,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_17" HorizontalAlignment="Left" Height="60" Margin="499,239,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_18" HorizontalAlignment="Left" Height="60" Margin="562,239,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_19" HorizontalAlignment="Left" Height="60" Margin="247,298,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_20" HorizontalAlignment="Left" Height="60" Margin="310,298,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_21" HorizontalAlignment="Left" Height="60" Margin="373,298,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_22" HorizontalAlignment="Left" Height="60" Margin="436,298,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_23" HorizontalAlignment="Left" Height="60" Margin="499,298,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_24" HorizontalAlignment="Left" Height="60" Margin="562,298,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_25" HorizontalAlignment="Left" Height="60" Margin="247,357,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_26" HorizontalAlignment="Left" Height="60" Margin="310,357,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_27" HorizontalAlignment="Left" Height="60" Margin="373,357,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_28" HorizontalAlignment="Left" Height="60" Margin="436,357,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_29" HorizontalAlignment="Left" Height="60" Margin="499,357,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Image x:Name="_30" HorizontalAlignment="Left" Height="60" Margin="562,357,0,0" VerticalAlignment="Top" Width="64" Stretch="Uniform"/>
            <Border x:Name="Selecao_Slot" HorizontalAlignment="Left" VerticalAlignment="Top" Width="64" Height="60" BorderBrush="#FFAEBEE8" BorderThickness="2" Background="Transparent" IsHitTestVisible="False" Visibility="Collapsed"/>
            <Button x:Name="Filtros" Content="Filtros" Style="{StaticResource BotaoPokemon}" HorizontalAlignment="Left" Height="43" Margin="658,0,0,0" VerticalAlignment="Top" Width="142" Click="Filtros_Click"/>
            <Border x:Name="PainelFiltros" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="142" Margin="0,43,0,10" Background="#FF000000" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <Button x:Name="Por_Type" Content="Tipos" Style="{StaticResource BotaoPokemon}" Height="30" Margin="0,0,0,4" Click="Por_Type_Click"/>
                            <Border x:Name="Types" Background="#FF000000" Margin="0,0,0,6" Padding="2" Visibility="Collapsed">
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="780" Height="429">
                                        <Image Source="/View/images/Tipagem/Types.png" Stretch="Fill"/>
                                        <Canvas x:Name="Tipos_Hotspots">
                                            <ToggleButton x:Name="Tipo_Normal" Style="{StaticResource HotspotTipo}" Canvas.Left="50" Canvas.Top="51" Width="148" Height="57" ToolTip="Normal"/>
                                            <ToggleButton x:Name="Tipo_Fight" Style="{StaticResource HotspotTipo}" Canvas.Left="220" Canvas.Top="51" Width="148" Height="57" ToolTip="Fighting"/>
                                            <ToggleButton x:Name="Tipo_Flying" Style="{StaticResource HotspotTipo}" Canvas.Left="392" Canvas.Top="51" Width="148" Height="57" ToolTip="Flying"/>
                                            <ToggleButton x:Name="Tipo_Poison" Style="{StaticResource HotspotTipo}" Canvas.Left="562" Canvas.Top="51" Width="148" Height="57" ToolTip="Poison"/>
                                            <ToggleButton x:Name="Tipo_Ground" Style="{StaticResource HotspotTipo}" Canvas.Left="50" Canvas.Top="124" Width="148" Height="57" ToolTip="Ground"/>
                                            <ToggleButton x:Name="Tipo_Rock" Style="{StaticResource HotspotTipo}" Canvas.Left="220" Canvas.Top="124" Width="148" Height="57" ToolTip="Rock"/>
                                            <ToggleButton x:Name="Tipo_Bug" Style="{StaticResource HotspotTipo}" Canvas.Left="392" Canvas.Top="124" Width="148" Height="57" ToolTip="Bug"/>
                                            <ToggleButton x:Name="Tipo_Ghost" Style="{StaticResource HotspotTipo}" Canvas.Left="562" Canvas.Top="124" Width="148" Height="57" ToolTip="Ghost"/>
                                            <ToggleButton x:Name="Tipo_Steel" Style="{StaticResource HotspotTipo}" Canvas.Left="50" Canvas.Top="197" Width="148" Height="57" ToolTip="Steel"/>
                                            <ToggleButton x:Name="Tipo_Electr" Style="{StaticResource HotspotTipo}" Canvas.Left="220" Canvas.Top="197" Width="148" Height="57" ToolTip="Electric"/>
                                            <ToggleButton x:Name="Tipo_Fire" Style="{StaticResource HotspotTipo}" Canvas.Left="392" Canvas.Top="197" Width="148" Height="57" ToolTip="Fire"/>
                                            <ToggleButton x:Name="Tipo_Water" Style="{StaticResource HotspotTipo}" Canvas.Left="562" Canvas.Top="197" Width="148" Height="57" ToolTip="Water"/>
                                            <ToggleButton x:Name="Tipo_Grass" Style="{StaticResource HotspotTipo}" Canvas.Left="50" Canvas.Top="270" Width="148" Height="57" ToolTip="Grass"/>
                                            <ToggleButton x:Name="Tipo_Dark" Style="{StaticResource HotspotTipo}" Canvas.Left="220" Canvas.Top="270" Width="148" Height="57" ToolTip="Dark"/>
                                            <ToggleButton x:Name="Tipo_Psychc" Style="{StaticResource HotspotTipo}" Canvas.Left="392" Canvas.Top="270" Width="148" Height="57" ToolTip="Psychic"/>
                                            <ToggleButton x:Name="Tipo_Ice" Style="{StaticResource HotspotTipo}" Canvas.Left="562" Canvas.Top="270" Width="148" Height="57" ToolTip="Ice"/>
                                            <ToggleButton x:Name="Tipo_Dragon" Style="{StaticResource HotspotTipo}" Canvas.Left="50" Canvas.Top="344" Width="148" Height="57" ToolTip="Dragon"/>
                                        </Canvas>
                                    </Grid>
                                </Viewbox>
                            </Border>

                            <Button x:Name="Por_Região" Content="Região" Style="{StaticResource BotaoPokemon}" Height="30" Margin="0,0,0,4" Click="Por_Regiao_Click"/>
                            <Border x:Name="Regioes" Background="#FF000000" Margin="0,0,0,6" Padding="4" Visibility="Collapsed">
                                <StackPanel>
                                    <CheckBox x:Name="Regiao_Kanto" Content="Kanto (Gen 1)" Foreground="White" Margin="0,2" IsChecked="True"/>
                                    <CheckBox x:Name="Regiao_Johto" Content="Johto (Gen 2)" Foreground="White" Margin="0,2" IsChecked="True"/>
                                    <CheckBox x:Name="Regiao_Hoenn" Content="Hoenn (Gen 3)" Foreground="White" Margin="0,2" IsChecked="True"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="Por_Favoritos" Content="Favoritos" Style="{StaticResource BotaoPokemon}" Height="30" Margin="0,0,0,4" Click="Por_Favoritos_Click"/>
                            <Border x:Name="Painel_Favoritos" Background="#FF000000" Margin="0,0,0,6" Padding="6,4" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock Text="Apenas Favoritos" Foreground="White" FontFamily="/View/fonts/#Pokemon Fire Red" FontSize="14" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="Filtro_Favoritos" Style="{StaticResource Interruptor}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Filtrar por favoritos"/>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,4">
                                <Button x:Name="Por_Id" Content="Id" Style="{StaticResource BotaoPokemon}" Height="30" Click="Por_Id_Click"/>
                                <TextBox x:Name="Id_TextBox" Height="30" Visibility="Collapsed" VerticalContentAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Button x:Name="Por_Nome" Content="Nome" Style="{StaticResource BotaoPokemon}" Height="30" Click="Por_Nome_Click"/>
                                <TextBox x:Name="Nome_TextBox" Height="30" Visibility="Collapsed" VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="6,0,6,6">
                        <Button x:Name="Limpar_Filtros" Content="Limpar" Style="{StaticResource BotaoPokemon}" Height="30" Margin="0,0,0,4" Click="Limpar_Filtros_Click"/>
                        <Button x:Name="Aplicar_Filtros" Content="Aplicar filtro" Style="{StaticResource BotaoPokemon}" Height="30" Click="Aplicar_Filtros_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Button x:Name="Shine" Content="Button" HorizontalAlignment="Left" Height="22" Margin="171,51,0,0" VerticalAlignment="Top" Width="27" Opacity="0"/>
            <ToggleButton x:Name="Botao_Favorito" Style="{StaticResource BotaoCoracao}" Width="22" Height="22" HorizontalAlignment="Left" Margin="28,50,0,0" VerticalAlignment="Top" Click="Favorito_Click" IsEnabled="False" ToolTip="Selecione um Pokémon">
                <Image x:Name="Icone_Favorito" Source="/View/images/hert-full-vazio.png" Stretch="Uniform"/>
            </ToggleButton>
        </Grid>
    </Viewbox>
</Page>
