<UserControl x:Class="GestaoDePokemon.View.Controles.GuiStatusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="703" d:DesignHeight="559"
             Width="703" Height="559" Background="Transparent">
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="/View/fonts/#Pokemon Fire Red"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="3" Direction="315" BlurRadius="0" Opacity="1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Raiz">
        <Image Source="/View/Telas - background/Gui-Status.png"
               Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <Grid x:Name="Camada"/>

        <Image x:Name="Type_pokemon" HorizontalAlignment="Left" Height="32" Margin="43,65,0,0" VerticalAlignment="Top" Width="78"/>
        <Image x:Name="Type_pokemon2" HorizontalAlignment="Left" Height="32" Margin="125,65,0,0" VerticalAlignment="Top" Width="78"/>
        <Image x:Name="Imagem_pokemon" HorizontalAlignment="Left" Height="163" Margin="37,103,0,0" VerticalAlignment="Top" Width="172"/>

        <Label x:Name="Id_pokemon" Content="Label" HorizontalAlignment="Left" Height="33" Margin="65,20,0,0" VerticalAlignment="Top" Width="52" FontSize="30"/>
        <Label x:Name="lvl_pokemon" Content="Label" HorizontalAlignment="Left" Height="33" Margin="185,20,0,0" VerticalAlignment="Top" Width="52" FontSize="30"/>
        <Label x:Name="Nome_pokemon" Content="Label" HorizontalAlignment="Left" Height="34" Margin="37,298,0,0" VerticalAlignment="Top" Width="172" FontSize="30"/>

        <!-- Cada linha: base stat da espécie | IV (0 a 31) | atributo com IV, EVs, nível e natureza | EVs investidos. -->
        <Label x:Name="Base_hp" Content="0" HorizontalAlignment="Left" Height="46" Margin="446,24,0,0" VerticalAlignment="Top" Width="50" FontSize="30" Foreground="#FFCCDAFF"/>
        <Label x:Name="IV_hp" Content="31" HorizontalAlignment="Left" Height="46" Margin="498,24,0,0" VerticalAlignment="Top" Width="48" FontSize="26" Foreground="#FFFFD86E"/>
        <Label x:Name="Stat_hp" Content="0" HorizontalAlignment="Left" Height="46" Margin="548,24,0,0" VerticalAlignment="Top" Width="68" FontSize="30"/>
        <Label x:Name="EV_hp" Content="+0" HorizontalAlignment="Left" Height="46" Margin="618,24,0,0" VerticalAlignment="Top" Width="68" FontSize="26" Foreground="#FF8CFFA8"/>
        <Label x:Name="Base_attack" Content="0" HorizontalAlignment="Left" Height="46" Margin="446,80,0,0" VerticalAlignment="Top" Width="50" FontSize="30" Foreground="#FFCCDAFF"/>
        <Label x:Name="IV_attack" Content="31" HorizontalAlignment="Left" Height="46" Margin="498,80,0,0" VerticalAlignment="Top" Width="48" FontSize="26" Foreground="#FFFFD86E"/>
        <Label x:Name="Stat_attack" Content="0" HorizontalAlignment="Left" Height="46" Margin="548,80,0,0" VerticalAlignment="Top" Width="68" FontSize="30"/>
        <Label x:Name="EV_attack" Content="+0" HorizontalAlignment="Left" Height="46" Margin="618,80,0,0" VerticalAlignment="Top" Width="68" FontSize="26" Foreground="#FF8CFFA8"/>
        <Label x:Name="Base_defense" Content="0" HorizontalAlignment="Left" Height="46" Margin="446,132,0,0" VerticalAlignment="Top" Width="50" FontSize="30" Foreground="#FFCCDAFF"/>
        <Label x:Name="IV_defense" Content="31" HorizontalAlignment="Left" Height="46" Margin="498,132,0,0" VerticalAlignment="Top" Width="48" FontSize="26" Foreground="#FFFFD86E"/>
        <Label x:Name="Stat_defense" Content="0" HorizontalAlignment="Left" Height="46" Margin="548,132,0,0" VerticalAlignment="Top" Width="68" FontSize="30"/>
        <Label x:Name="EV_defense" Content="+0" HorizontalAlignment="Left" Height="46" Margin="618,132,0,0" VerticalAlignment="Top" Width="68" FontSize="26" Foreground="#FF8CFFA8"/>
        <Label x:Name="Base_special_attack" Content="0" HorizontalAlignment="Left" Height="46" Margin="446,190,0,0" VerticalAlignment="Top" Width="50" FontSize="30" Foreground="#FFCCDAFF"/>
        <Label x:Name="IV_special_attack" Content="31" HorizontalAlignment="Left" Height="46" Margin="498,190,0,0" VerticalAlignment="Top" Width="48" FontSize="26" Foreground="#FFFFD86E"/>
        <Label x:Name="Stat_special_attack" Content="0" HorizontalAlignment="Left" Height="46" Margin="548,190,0,0" VerticalAlignment="Top" Width="68" FontSize="30"/>
        <Label x:Name="EV_special_attack" Content="+0" HorizontalAlignment="Left" Height="46" Margin="618,190,0,0" VerticalAlignment="Top" Width="68" FontSize="26" Foreground="#FF8CFFA8"/>
        <Label x:Name="Base_special_defense" Content="0" HorizontalAlignment="Left" Height="46" Margin="446,243,0,0" VerticalAlignment="Top" Width="50" FontSize="30" Foreground="#FFCCDAFF"/>
        <Label x:Name="IV_special_defense" Content="31" HorizontalAlignment="Left" Height="46" Margin="498,243,0,0" VerticalAlignment="Top" Width="48" FontSize="26" Foreground="#FFFFD86E"/>
        <Label x:Name="Stat_special_defense" Content="0" HorizontalAlignment="Left" Height="46" Margin="548,243,0,0" VerticalAlignment="Top" Width="68" FontSize="30"/>
        <Label x:Name="EV_special_defense" Content="+0" HorizontalAlignment="Left" Height="46" Margin="618,243,0,0" VerticalAlignment="Top" Width="68" FontSize="26" Foreground="#FF8CFFA8"/>
        <Label x:Name="Base_speed" Content="0" HorizontalAlignment="Left" Height="46" Margin="446,302,0,0" VerticalAlignment="Top" Width="50" FontSize="30" Foreground="#FFCCDAFF"/>
        <Label x:Name="IV_speed" Content="31" HorizontalAlignment="Left" Height="46" Margin="498,302,0,0" VerticalAlignment="Top" Width="48" FontSize="26" Foreground="#FFFFD86E"/>
        <Label x:Name="Stat_speed" Content="0" HorizontalAlignment="Left" Height="46" Margin="548,302,0,0" VerticalAlignment="Top" Width="68" FontSize="30"/>
        <Label x:Name="EV_speed" Content="+0" HorizontalAlignment="Left" Height="46" Margin="618,302,0,0" VerticalAlignment="Top" Width="68" FontSize="26" Foreground="#FF8CFFA8"/>
        <!-- Faixa acima dos atributos: saldo de EVs à esquerda e o nome de cada coluna, na cor dela. -->
        <Label x:Name="EVs_disponiveis" Content="EVs disponíveis: 510" HorizontalAlignment="Left" Height="26" Margin="262,3,0,0" VerticalAlignment="Top" Width="180" FontSize="20"
               Padding="5,0" HorizontalContentAlignment="Left"
               ToolTip="EVs que ainda podem ser distribuídos (510 no total, até 252 por atributo)."/>
        <Label x:Name="Titulo_base" Content="Base" HorizontalAlignment="Left" Height="26" Margin="446,3,0,0" VerticalAlignment="Top" Width="50" FontSize="20" Padding="0" Foreground="#FFCCDAFF"
               ToolTip="Base stat: valor fixo da espécie (ou da forma, como as regionais e as Megas)."/>
        <Label x:Name="Titulo_iv" Content="IV" HorizontalAlignment="Left" Height="26" Margin="498,3,0,0" VerticalAlignment="Top" Width="48" FontSize="20" Padding="0" Foreground="#FFFFD86E"
               ToolTip="IV: potencial individual do Pokémon em cada atributo, de 0 a 31. Clique no número para mudar."/>
        <Label x:Name="Titulo_valor" Content="Valor" HorizontalAlignment="Left" Height="26" Margin="548,3,0,0" VerticalAlignment="Top" Width="68" FontSize="20" Padding="0"
               ToolTip="Valor do atributo no nível atual, calculado com base stat, IV, EVs e natureza, como nos jogos."/>
        <Label x:Name="Titulo_evs" Content="EVs" HorizontalAlignment="Left" Height="26" Margin="618,3,0,0" VerticalAlignment="Top" Width="68" FontSize="20" Padding="0" Foreground="#FF8CFFA8"
               ToolTip="EVs: pontos de treino investidos no atributo (0 a 252, 510 no total). Clique no número para mudar."/>

        <Label x:Name="Nature_pokemon" Content="Label" HorizontalAlignment="Left" Height="42" Margin="527,422,0,0" VerticalAlignment="Top" Width="125" FontSize="35"/>
        <ComboBox x:Name="Nature_select" Visibility="Collapsed" HorizontalAlignment="Left" Height="42" Margin="527,431,0,0" VerticalAlignment="Top" Width="125"
                  FontFamily="/View/fonts/#Pokemon Fire Red" FontSize="20" Foreground="White" Background="#FF303030" BorderBrush="White">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="FontFamily" Value="/View/fonts/#Pokemon Fire Red"/>
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#FF303030"/>
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>
        <Label x:Name="Nature_effect" Content="sem efeito" HorizontalAlignment="Left" Height="42" Margin="503,454,0,0" VerticalAlignment="Top" Width="175" FontSize="30"/>
        <Label x:Name="happiness_pokemon" Content="Label" HorizontalAlignment="Left" Height="32" Margin="340,431,0,0" VerticalAlignment="Top" Width="44" FontSize="30"/>
        <Label Content="Éxi" HorizontalAlignment="Left" Height="34" Margin="81,408,0,0" VerticalAlignment="Top" Width="74" FontSize="30"/>
        <Label x:Name="Size_A" Content="Label" HorizontalAlignment="Left" Height="42" Margin="81,431,0,0" VerticalAlignment="Top" Width="74" FontSize="30"/>
        <Label x:Name="Size_subA" Content="Label" HorizontalAlignment="Left" Height="40" Margin="81,459,0,0" VerticalAlignment="Top" Width="74" FontSize="30"/>

        <Button x:Name="Voltar_Time" Content="Button" Opacity="0" HorizontalAlignment="Left" Height="50" Margin="639,509,0,0" VerticalAlignment="Top" Width="64"/>
        <Button x:Name="Ir_summary" Content="Button" Opacity="0" HorizontalAlignment="Left" Height="50" Margin="0,509,0,0" VerticalAlignment="Top" Width="254"/>
        <Button x:Name="Ir_moves" Content="Button" Opacity="0" HorizontalAlignment="Center" Height="50" Margin="0,509,0,0" VerticalAlignment="Top" Width="184"/>
    </Grid>
</UserControl>
