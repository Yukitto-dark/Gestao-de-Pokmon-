<UserControl x:Class="GestaoDePokemon.View.Controles.GuiSummaryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="827" d:DesignHeight="657"
             Width="827" Height="657" Background="Transparent">
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="/View/fonts/#Pokemon Fire Red"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="3" Direction="315" BlurRadius="0" Opacity="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botões "-" e "+" do seletor de nível, no padrão dos campos de edição do popup. -->
        <Style x:Key="BotaoNivel" TargetType="Button">
            <Setter Property="FontFamily" Value="/View/fonts/#Pokemon Fire Red"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FF303030" BorderBrush="White" BorderThickness="2" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1E1E1E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrilhaNivel" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="12" VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de nível (1 a 100) no estilo das barras de HP/EXP da imagem de fundo. -->
        <Style x:Key="SliderNivel" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="20" VerticalAlignment="Center" Background="#FF303030" BorderBrush="White" BorderThickness="2" CornerRadius="3"/>
                            <Track x:Name="PART_Track" Margin="4,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrilhaNivel}" Background="#FF2ECC40"
                                                  Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrilhaNivel}" Background="Transparent"
                                                  Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="34">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="White" BorderBrush="#FF303030" BorderThickness="2" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Image Source="/View/Telas - background/Gui-Summary.png"
               Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <Grid/>

        <Image x:Name="Type_pokemon" HorizontalAlignment="Left" Height="32" Margin="66,111,0,0" VerticalAlignment="Top" Width="78"/>
        <Image x:Name="Type_pokemon2" HorizontalAlignment="Left" Height="32" Margin="148,111,0,0" VerticalAlignment="Top" Width="78"/>
        <Image x:Name="Imagem_pokemon" HorizontalAlignment="Left" Height="180" Margin="56,151,0,0" VerticalAlignment="Top" Width="180"/>

        <Label x:Name="Id_pokemon" Content="Label" HorizontalAlignment="Left" Height="37" Margin="84,27,0,0" VerticalAlignment="Top" Width="52" FontSize="35"/>
        <Label x:Name="lvl_pokemon" Content="Label" HorizontalAlignment="Left" Height="38" Margin="216,27,0,0" VerticalAlignment="Top" Width="52" FontSize="35"/>
        <Label x:Name="Vida" Content="X/Y" HorizontalAlignment="Left" Height="44" Margin="527,25,0,0" VerticalAlignment="Top" Width="108" FontSize="35"/>
        <Label x:Name="Nome_pokemon" Content="Label" HorizontalAlignment="Left" Height="43" Margin="56,351,0,0" VerticalAlignment="Top" Width="180" FontSize="35"/>
        <Label x:Name="Experiencia" Content="X" HorizontalAlignment="Left" Height="38" Margin="505,258,0,0" VerticalAlignment="Top" Width="110" FontSize="35"/>
        <!-- Seletor de nível: "-" e "+" mudam um nível; a barra vai direto ao nível desejado. -->
        <Grid x:Name="Seletor_nivel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="332,360,0,0" Width="466" Height="46"
              ToolTip="Escolha o nível do Pokémon (1 a 100)">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="96"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="Nivel_menos" Grid.Column="0" Content="-" Style="{StaticResource BotaoNivel}" ToolTip="Diminuir um nível"/>
            <Slider x:Name="Nivel_slider" Grid.Column="1" Margin="8,0" Minimum="1" Maximum="100" Value="100"
                    SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                    IsMoveToPointEnabled="True" Style="{StaticResource SliderNivel}" VerticalAlignment="Center"/>
            <Button x:Name="Nivel_mais" Grid.Column="2" Content="+" Style="{StaticResource BotaoNivel}" ToolTip="Aumentar um nível"/>
            <Label x:Name="Nivel_valor" Grid.Column="3" Content="Nv 100" FontSize="30" Margin="4,0,0,0"/>
        </Grid>
        <Label x:Name="Ability" Content="Label" HorizontalAlignment="Left" Height="40" Margin="546,449,0,0" VerticalAlignment="Top" Width="141" FontSize="36"/>
        <TextBlock x:Name="Info_ability" Text="Label" HorizontalAlignment="Left" Height="77" Margin="340,510,0,0" VerticalAlignment="Top" Width="445"
                   FontFamily="/View/fonts/#Pokemon Fire Red" FontSize="30" Foreground="White"
                   TextWrapping="Wrap" TextAlignment="Left" MaxWidth="445">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" ShadowDepth="3" Direction="315" BlurRadius="0" Opacity="1"/>
            </TextBlock.Effect>
        </TextBlock>

        <Button x:Name="Ir_Moves" Content="Button" Opacity="0" HorizontalAlignment="Left" Height="48" Margin="310,609,0,0" VerticalAlignment="Top" Width="212"/>
        <Button x:Name="Ir_stats" Content="Button" Opacity="0" HorizontalAlignment="Left" Height="48" Margin="527,609,0,0" VerticalAlignment="Top" Width="216"/>
        <Button x:Name="Voltar_Time" Content="Button" Opacity="0" HorizontalAlignment="Left" Height="44" Margin="756,609,0,0" VerticalAlignment="Top" Width="71"/>
        <Image x:Name="Ir_Move" Opacity="0" HorizontalAlignment="Left" Height="51" Margin="70,100,0,0" VerticalAlignment="Top" Width="152"/>
    </Grid>
</UserControl>
